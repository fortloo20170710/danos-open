# Minimal deployment image for the DANOS-Open control plane.
# Build the binaries first (cmake), stage them into a small context, then:
#   mkdir -p oci-context/build/danos-mgrd oci-context/danos-mgrd
#   cp build/danos-mgrd/danos-mgrd oci-context/build/danos-mgrd/
#   cp danos-mgrd/danos-mgrd.service oci-context/danos-mgrd/
#   docker build -f danos-build/Dockerfile.mgrd -t danos-mgrd:v0.6.0 oci-context
# Building with the repository root as context also works if .dockerignore
# does not exclude build/ (it does, to keep the source-image context small).
# Result: ~85 MB (vs 7.5 GB danos-build toolchain image).

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

COPY build/danos-mgrd/danos-mgrd /usr/bin/danos-mgrd
COPY danos-mgrd/danos-mgrd.service /lib/systemd/system/danos-mgrd.service

RUN mkdir -p /var/lib/danos && useradd --system danos || true

EXPOSE 59200 59201
VOLUME /var/lib/danos

# Control plane only: gNMI mTLS (mount/configure certificates) + /metrics
ENTRYPOINT ["/usr/bin/danos-mgrd"]
CMD ["--port", "59200", "--metrics-port", "59201", "--wal", "/var/lib/danos/mgrd.wal", "--seed"]
