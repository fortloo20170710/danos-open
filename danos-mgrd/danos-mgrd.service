[Unit]
Description=DANOS-Open management daemon (control plane)
Documentation=https://github.com/danos-open/danos-open
After=network.target vpp.service

[Service]
Type=simple
# Configure DANOS_TLS_CERT/KEY/CLIENT_CA/ROLE_FILE in this protected file.
EnvironmentFile=-/etc/danos/mgrd.env
ExecStart=/usr/bin/danos-mgrd --port 59200 --metrics-port 59201 --wal /var/lib/danos/mgrd.wal
Restart=on-failure
RestartSec=1
# crash recovery is a core feature: WAL replay + reconcile on restart
StateDirectory=danos
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
